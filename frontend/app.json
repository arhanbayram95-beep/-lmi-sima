{
  "expo": {
    "name": "Questborn",
    "slug": "arhan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arhanbayram.facereader",
      "infoPlist": {
        "NSCameraUsageDescription": "Questborn uses your camera to take the photos your fantasy character is based on. Photos are processed in memory and never stored.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.arhanbayram.facereader",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A050B"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A050B"
        }
      ],
      "expo-asset",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Questborn uses your photo library so you can choose an existing photo to base your character on. Photos are processed in memory and never stored.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2970ea0e-9543-40f9-bdab-711f9e120980"
      }
    },
    "owner": "arhanbayrams-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2970ea0e-9543-40f9-bdab-711f9e120980"
    }
  }
}
